<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#050505">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    
    <!-- SEO -->
    <title>Active Mirror — Sovereign AI That Reflects, Not Directs</title>
    <meta name="description" content="A reflective AI thinking partner. No advice, no data collection, no manipulation. Just questions that help you think more clearly. Run locally or in the cloud.">
    <meta name="keywords" content="AI, reflection, sovereign AI, privacy, local AI, thinking partner, no advice">
    <meta name="author" content="N1 Intelligence">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://activemirror.ai/mirror/">
    <meta property="og:title" content="Active Mirror — Sovereign AI That Reflects, Not Directs">
    <meta property="og:description" content="A reflective AI thinking partner. No advice, no data collection. Just questions that help you think more clearly.">
    <meta property="og:image" content="https://activemirror.ai/active-mirror-logo.jpg">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Active Mirror — Sovereign AI">
    <meta name="twitter:description" content="AI that reflects, not directs. No advice, no data collection.">
    <meta name="twitter:image" content="https://activemirror.ai/active-mirror-logo.jpg">
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="favicon.png">
    <link rel="apple-touch-icon" href="logo.jpg">
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://api.groq.com">
    <link rel="dns-prefetch" href="https://proxy.activemirror.ai">
    
    <style>
        /* ═══════════════════════════════════════════════════════════════════════════
           ⟡ ACTIVE MIRROR - PREMIUM GLASSMORPHISM UI
           ═══════════════════════════════════════════════════════════════════════════ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #050505;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --amber: #f59e0b;
            --purple: #8b5cf6;
            --green: #10b981;
            --text: #ffffff;
            --text-dim: #71717a;
            --radius: 20px;
            --safe-bottom: env(safe-area-inset-bottom, 20px);
        }

        html,
        body {
            height: 100%;
            height: 100dvh;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Animated Background ─── */
        .bg-orbs {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            animation: float 20s ease-in-out infinite;
        }

        .orb-1 {
            width: 400px;
            height: 400px;
            background: var(--amber);
            top: -100px;
            left: -100px;
            animation-delay: 0s;
        }

        .orb-2 {
            width: 300px;
            height: 300px;
            background: var(--purple);
            bottom: -50px;
            right: -50px;
            animation-delay: -7s;
        }

        .orb-3 {
            width: 200px;
            height: 200px;
            background: var(--purple);
            top: 50%;
            left: 50%;
            animation-delay: -14s;
            opacity: 0.15;
        }

        @keyframes float {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            33% {
                transform: translate(30px, -30px) scale(1.1);
            }

            66% {
                transform: translate(-20px, 20px) scale(0.9);
            }
        }

        /* ─── App Container ─── */
        #app {
            position: relative;
            height: 100%;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            z-index: 1;
        }

        /* ─── Glass Panel ─── */
        .glass {
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
        }

        /* ─── Welcome Screen ─── */
        #welcome {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            z-index: 100;
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        #welcome.hidden {
            opacity: 0;
            transform: scale(0.95);
            pointer-events: none;
        }

        .glyph {
            font-size: 72px;
            color: var(--amber);
            animation: pulse-glow 2s ease-in-out infinite;
            margin-bottom: 24px;
        }

        @keyframes pulse-glow {

            0%,
            100% {
                text-shadow: 0 0 20px var(--amber), 0 0 40px var(--amber);
                transform: scale(1);
            }

            50% {
                text-shadow: 0 0 40px var(--amber), 0 0 80px var(--amber);
                transform: scale(1.05);
            }
        }

        .welcome-title {
            font-size: 28px;
            font-weight: 200;
            letter-spacing: 0.1em;
            margin-bottom: 8px;
            opacity: 0;
            animation: fade-up 0.8s ease forwards 0.3s;
        }

        .welcome-tagline {
            font-size: 14px;
            color: var(--text-dim);
            margin-bottom: 48px;
            opacity: 0;
            animation: fade-up 0.8s ease forwards 0.5s;
        }

        @keyframes fade-up {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ─── Mode Cards ─── */
        .mode-cards {
            display: flex;
            flex-direction: column;
            gap: 16px;
            width: 100%;
            max-width: 400px;
        }

        .mode-card {
            padding: 20px 24px;
            cursor: pointer;
            transition: all 0.3s ease;
            opacity: 0;
            animation: fade-up 0.6s ease forwards;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .mode-card:nth-child(1) {
            animation-delay: 0.7s;
        }

        .mode-card:nth-child(2) {
            animation-delay: 0.9s;
        }

        .mode-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .mode-card:active {
            transform: scale(0.98);
        }

        .mode-icon {
            font-size: 32px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
        }

        .mode-info {
            flex: 1;
        }

        .mode-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 4px;
        }

        .mode-desc {
            font-size: 13px;
            color: var(--text-dim);
        }

        .mode-badge {
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .badge-instant {
            background: var(--amber);
            color: black;
        }

        .badge-sovereign {
            background: var(--purple);
            color: white;
        }

        /* ─── Loading Screen ─── */
        #loading {
            position: absolute;
            inset: 0;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            z-index: 90;
        }

        #loading.active {
            display: flex;
        }

        .progress-ring {
            position: relative;
            width: 160px;
            height: 160px;
            margin-bottom: 32px;
        }

        .progress-ring svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .progress-ring circle {
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
        }

        .progress-bg {
            stroke: rgba(255, 255, 255, 0.1);
        }

        .progress-fill {
            stroke: var(--purple);
            stroke-dasharray: 440;
            stroke-dashoffset: 440;
            transition: stroke-dashoffset 0.3s ease, stroke 0.5s ease;
            filter: drop-shadow(0 0 10px var(--purple));
        }

        .progress-text {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .progress-percent {
            font-size: 42px;
            font-weight: 200;
        }

        .progress-label {
            font-size: 12px;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .loading-status {
            font-size: 14px;
            color: var(--text-dim);
            text-align: center;
            max-width: 280px;
        }

        /* ─── Chat Interface ─── */
        #chat {
            display: none;
            flex-direction: column;
            height: 100%;
            max-height: 100dvh;
            overflow: hidden;
        }

        #chat.active {
            display: flex;
        }

        .chat-header {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--glass-border);
        }

        .chat-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chat-glyph {
            font-size: 20px;
            color: var(--amber);
        }

        .chat-title {
            font-size: 16px;
            font-weight: 500;
        }

        .chat-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-dim);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* ─── Messages ─── */
        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            padding-bottom: 80px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }

        .message {
            max-width: 85%;
            padding: 14px 18px;
            border-radius: 18px;
            animation: message-in 0.4s ease;
            line-height: 1.5;
            font-size: 15px;
        }

        @keyframes message-in {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message-user {
            align-self: flex-end;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .message-ai {
            align-self: flex-start;
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.2);
        }

        /* ─── Thinking Indicator ─── */
        .thinking {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            font-size: 14px;
            color: var(--text-dim);
        }

        .thinking-glyph {
            color: var(--amber);
            animation: spin-slow 3s linear infinite;
        }

        @keyframes spin-slow {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* ─── Input Area ─── */
        .input-area {
            padding: 16px 20px;
            padding-bottom: calc(16px + var(--safe-bottom));
            border-top: 1px solid var(--glass-border);
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            transition: all 0.3s ease;
        }

        .input-wrapper:focus-within {
            border-color: var(--amber);
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
        }

        #input {
            flex: 1;
            background: none;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 16px;
            font-family: inherit;
        }

        #input::placeholder {
            color: var(--text-dim);
        }

        .send-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            border: none;
            background: var(--amber);
            color: black;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-size: 18px;
        }

        .send-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px var(--amber);
        }

        .send-btn:active {
            transform: scale(0.95);
        }

        .send-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* ─── Session Counter ─── */
        .session-counter {
            text-align: center;
            padding: 8px;
            font-size: 12px;
            color: var(--text-dim);
        }

        /* ─── Back Button ─── */
        .back-btn {
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .back-btn:hover {
            color: var(--text);
            background: rgba(255, 255, 255, 0.1);
        }

        /* ─── Chat Footer ─── */
        .chat-footer {
            padding: 8px 20px;
            padding-bottom: calc(8px + var(--safe-bottom));
            text-align: center;
            font-size: 10px;
            color: #555;
            border-top: 1px solid var(--glass-border);
        }
        
        .chat-footer a {
            color: #666;
            text-decoration: none;
            margin: 0 8px;
        }
        
        .chat-footer a:hover {
            color: #888;
        }

        /* ─── Responsive ─── */
        @media (max-width: 480px) {
            .welcome-title {
                font-size: 24px;
            }

            .glyph {
                font-size: 56px;
            }

            .mode-card {
                padding: 16px 20px;
            }
        }

        /* ─── Reduced Motion ─── */
        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
    <!-- Consent Gate (MUST accept before using) -->
    <div id="consent-gate" style="display: flex; position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 10000; padding: 20px; overflow: auto; align-items: center; justify-content: center;">
        <div style="max-width: 480px; background: #0a0a0a; border: 1px solid #333; border-radius: 16px; padding: 32px;">
            <div style="text-align: center; margin-bottom: 24px;">
                <span style="font-size: 48px;">⚠️</span>
                <h2 style="color: #fff; font-size: 22px; margin-top: 16px;">Before You Begin</h2>
            </div>
            
            <div style="background: #1a1a1a; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                <p style="color: #f59e0b; font-weight: 600; margin-bottom: 12px;">This is an experimental AI tool.</p>
                <ul style="color: #aaa; font-size: 14px; line-height: 1.8; margin-left: 16px;">
                    <li>It may produce <strong style="color: #fff;">inaccurate or fabricated</strong> responses</li>
                    <li>It is <strong style="color: #fff;">NOT</strong> a therapist, doctor, lawyer, or advisor</li>
                    <li>It <strong style="color: #fff;">cannot</strong> provide professional help of any kind</li>
                    <li>It is <strong style="color: #fff;">NOT</strong> suitable for crisis situations</li>
                </ul>
            </div>
            
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                <p style="color: #fca5a5; font-size: 13px; line-height: 1.6;">
                    <strong>If you're in crisis:</strong> Please contact emergency services (911), the Suicide Prevention Lifeline (988), or Crisis Text Line (text HOME to 741741).
                </p>
            </div>
            
            <div style="font-size: 12px; color: #666; margin-bottom: 20px; line-height: 1.6;">
                By continuing, you acknowledge that you:
                <ul style="margin-top: 8px; margin-left: 16px;">
                    <li>Use this tool <strong style="color: #888;">at your own risk</strong></li>
                    <li>Will not rely on it for important decisions</li>
                    <li>Accept the <a href="/terms" target="_blank" style="color: #f59e0b;">Terms of Service</a> and <a href="/privacy" target="_blank" style="color: #f59e0b;">Privacy Policy</a></li>
                </ul>
            </div>
            
            <button onclick="acceptConsent()" style="width: 100%; padding: 16px; background: linear-gradient(135deg, #f59e0b, #d97706); border: none; border-radius: 12px; color: #000; font-size: 16px; font-weight: 600; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 0 30px rgba(245,158,11,0.3)';" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';">
                I Understand — Continue
            </button>
            
            <p style="text-align: center; margin-top: 16px; font-size: 11px; color: #555;">
                Not ready? <a href="/" style="color: #666;">Return to homepage</a>
            </p>
        </div>
    </div>

    <!-- Safety Disclaimer Banner (shown after consent) -->
    <div id="disclaimer" style="background: #1a1a1a; border-bottom: 1px solid #333; padding: 8px 16px; font-size: 11px; color: #888; text-align: center;">
        ⚠️ Experimental · Not professional advice · <a href="#" onclick="document.getElementById('safety-info').style.display='block';return false;" style="color: #f59e0b;">Safety Info</a> · <a href="/terms" target="_blank" style="color: #666;">Terms</a> · <a href="/privacy" target="_blank" style="color: #666;">Privacy</a>
    </div>
    
    <!-- Safety Info Modal (hidden by default) -->
    <div id="safety-info" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 9999; padding: 20px; overflow: auto;">
        <div style="max-width: 500px; margin: 40px auto; background: #111; border: 1px solid #333; border-radius: 12px; padding: 24px;">
            <h2 style="color: #fff; margin-bottom: 16px;">⚠️ Important Safety Information</h2>
            <div style="color: #aaa; font-size: 14px; line-height: 1.6;">
                <p style="margin-bottom: 12px;"><strong style="color: #f59e0b;">This is NOT:</strong></p>
                <ul style="margin-left: 20px; margin-bottom: 16px;">
                    <li>A therapist or mental health professional</li>
                    <li>A doctor or medical advisor</li>
                    <li>A lawyer or legal advisor</li>
                    <li>A financial advisor</li>
                </ul>
                <p style="margin-bottom: 12px;"><strong style="color: #f59e0b;">This IS:</strong></p>
                <ul style="margin-left: 20px; margin-bottom: 16px;">
                    <li>An experimental AI that asks reflective questions</li>
                    <li>A thinking tool, not an advice tool</li>
                    <li>For exploration, not decisions</li>
                </ul>
                <p style="margin-bottom: 12px;"><strong style="color: #f59e0b;">If you're in crisis:</strong></p>
                <ul style="margin-left: 20px; margin-bottom: 16px;">
                    <li>Crisis Text Line: Text HOME to 741741</li>
                    <li>Suicide Prevention: 988 (US)</li>
                    <li>Emergency: 911 / your local emergency number</li>
                </ul>
                <p style="color: #666; font-size: 12px;">Your conversations are processed locally or via Groq API. We don't store your messages.</p>
            </div>
            <button onclick="document.getElementById('safety-info').style.display='none'" style="margin-top: 16px; width: 100%; padding: 12px; background: #333; border: none; border-radius: 8px; color: #fff; cursor: pointer;">I Understand</button>
        </div>
    </div>

    <!-- Animated Background -->
    <div class="bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <div id="app">
        <!-- Welcome Screen -->
        <div id="welcome">
            <div class="glyph">⟡</div>
            <h1 class="welcome-title">ACTIVE MIRROR</h1>
            <p class="welcome-tagline">Sovereign AI that reflects, not directs</p>

            <div class="mode-cards">
                <div class="mode-card glass" onclick="startCloud()">
                    <div class="mode-icon">☁️</div>
                    <div class="mode-info">
                        <div class="mode-title">Cloud Reflection</div>
                        <div class="mode-desc">Powered by Llama 3.3-70B</div>
                    </div>
                    <span class="mode-badge badge-instant">Instant</span>
                </div>

                <div class="mode-card glass" onclick="startSovereign()" id="sovereign-card">
                    <div class="mode-icon">🧠</div>
                    <div class="mode-info">
                        <div class="mode-title">Sovereign Mode</div>
                        <div class="mode-desc">100% local, 100% private</div>
                        <div class="mode-storage" style="font-size: 10px; color: #888; margin-top: 4px;">~900MB download, stored in browser cache</div>
                    </div>
                    <span class="mode-badge badge-sovereign">Local AI</span>
                </div>
            </div>
            
            <p class="storage-note" style="font-size: 11px; color: #666; margin-top: 16px; max-width: 320px; text-align: center;">
                💡 Sovereign mode downloads once, then works offline. To clear storage later, use browser settings → Clear site data.
            </p>
        </div>

        <!-- Loading Screen -->
        <div id="loading">
            <div class="progress-ring">
                <svg viewBox="0 0 160 160">
                    <circle class="progress-bg" cx="80" cy="80" r="70"></circle>
                    <circle class="progress-fill" cx="80" cy="80" r="70" id="progress-circle"></circle>
                </svg>
                <div class="progress-text">
                    <div class="progress-percent" id="progress-percent">0%</div>
                    <div class="progress-label">Loading</div>
                </div>
            </div>
            <p class="loading-status" id="loading-status">Preparing your sovereign AI...</p>
        </div>

        <!-- Chat Interface -->
        <div id="chat">
            <header class="chat-header">
                <button class="back-btn" onclick="showWelcome()">←</button>
                <div class="chat-brand">
                    <span class="chat-glyph">⟡</span>
                    <span class="chat-title">Active Mirror</span>
                </div>
                <div class="chat-status">
                    <span class="status-dot" id="proxy-dot" title="Safety proxy status"></span>
                    <span id="mode-label">Cloud</span>
                    <span id="proxy-badge" style="font-size: 9px; background: #22c55e22; color: #22c55e; padding: 2px 6px; border-radius: 4px; margin-left: 8px;">🛡️ Protected</span>
                </div>
            </header>

            <div class="messages" id="messages">
                <!-- Messages appear here -->
            </div>

            <div class="session-counter" id="session-counter">Start your reflection</div>

            <div class="input-area">
                <div class="input-wrapper">
                    <input type="text" id="input" placeholder="What's on your mind?" autocomplete="off">
                    <button class="send-btn" id="send-btn" onclick="send()">→</button>
                </div>
            </div>
            
            <div class="chat-footer">
                <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <span style="color: #444;">© 2026 N1 Intelligence</span>
            </div>
        </div>
    </div>

    <script type="module">
        // ═══════════════════════════════════════════════════════════════════════════
        // ⟡ ACTIVE MIRROR - PREMIUM UX ENGINE
        // ═══════════════════════════════════════════════════════════════════════════

        // Note: WebLLM is imported dynamically in startSovereign() to avoid blocking cloud mode

        // ─── Consent Gate ───
        // User MUST accept every single visit - no localStorage, no persistence
        // This ensures informed consent is obtained each session
        
        function acceptConsent() {
            document.getElementById('consent-gate').style.display = 'none';
        }
        
        // Expose to window for onclick
        window.acceptConsent = acceptConsent;
        
        // Gate is ALWAYS shown on page load - no bypass

        // Config
        const DEBUG = false;  // Set to true for console logging
        const GROQ_KEY = 'gsk_placeholder_replace_with_real_key';
        const MODEL_ID = 'Qwen2.5-1.5B-Instruct-q4f16_1-MLC'; // ~900MB, good quality

        const SYSTEM_PROMPT = `You are Active Mirror, a reflective thinking partner. You help humans think more clearly by asking questions—never by giving answers, advice, or information.

ABSOLUTE RULES (NEVER BREAK):
1. ONLY respond with 1-2 reflective questions. Nothing else.
2. NEVER give advice, recommendations, or suggestions.
3. NEVER state facts, statistics, or information.
4. NEVER diagnose, prescribe, or recommend medical/legal/financial actions.
5. NEVER engage with self-harm, violence, or illegal topics—redirect to "What support do you need right now?"
6. NEVER pretend to be a therapist, doctor, lawyer, or expert.
7. NEVER say "I think", "I believe", "You should", "I recommend", or make any assertions.

SAFE REDIRECTS:
- Medical questions → "What's prompting you to ask about this? Have you spoken with a healthcare provider?"
- Legal questions → "What outcome are you hoping for? Have you considered consulting a professional?"
- Crisis/self-harm → "It sounds like you're going through something difficult. What support do you have around you?"
- Financial advice → "What's driving this financial decision? What would help you feel more confident?"

RESPONSE FORMAT:
- Maximum 40 words
- End with a question mark
- Mirror their language
- Stay curious, not directive

EXAMPLES:
User: "Should I quit my job?" → "What would quitting make possible for you?"
User: "I feel depressed" → "What does that feel like in your body right now?"
User: "What medication should I take?" → "What's prompting this question? Have you been able to speak with a doctor?"
User: "How do I hack into..." → "What's the underlying need here?"

You are a mirror, not an advisor. Questions only. When in doubt, ask: "What feels most important about this?"`;

        // ─── SAFETY SYSTEM ───
        // (Main safety logic is in CLIENT-SIDE SAFETY section below)
        
        // Wrapper for cloud mode that uses clientSideGate
        function safetyCheck(userMsg) {
            const gate = clientSideGate(userMsg);
            if (gate.blocked) {
                return { safe: false, response: gate.response };
            }
            return { safe: true, hint: null };
        }

        // Truth-State tags for post-processing
        const TRUTH_STATES = {
            FACT: '◉',      // Verifiable, grounded
            ESTIMATE: '◐',  // Reasoned but uncertain  
            UNKNOWN: '○'    // Insufficient data
        };

        // ─── Reflection Wrapper (Post-processing) ───
        function wrapReflection(response) {
            let cleaned = response.trim();
            
            // FORBIDDEN PATTERNS - if any match, replace entirely
            const forbiddenPatterns = [
                // Medical/Legal/Financial
                /\b(medication|medicine|drug|pill|dosage|prescription|dose)\b/i,
                /\b(therapist|psychiatrist|psychologist|counselor|doctor|physician)\b/i,
                /\b(diagnosis|diagnose|treatment|therapy|cure)\b/i,
                /\b(lawsuit|attorney|lawyer|legal action|sue|court)\b/i,
                /\b(invest|stock|crypto|bitcoin|trading|gambling|portfolio)\b/i,
                // Crisis (should be caught earlier, but double-check)
                /\b(suicide|kill|harm|hurt yourself|end your life)\b/i,
                // Certainty language
                /\b(definitely|certainly|absolutely|always|never|guaranteed)\b/i,
                /\b(obviously|clearly|undoubtedly|without a doubt)\b/i,
                // Directive language
                /\b(you should|you must|you need to|you have to|you ought to)\b/i,
                /\b(i recommend|i suggest|i advise|my advice|my recommendation)\b/i,
                /\b(the best|the right|the correct|the proper|the only)\b/i,
                /\b(do this|do that|try this|try that|go ahead)\b/i,
                /\b(here'?s what|what you should|first step|next step)\b/i,
                /\b(make sure|be sure to|don'?t forget to)\b/i,
                // Pseudo-therapeutic
                /\b(i understand how you feel|i know what you'?re going through)\b/i,
                /\b(i hear you|i see you|that must be)\b/i,
                /\bhave you (tried|considered) (taking|using|seeing|talking)\b/i,
                /\bwhy don'?t you\b/i,
                /\bhave you thought about\b/i,
                // Factual claims
                /\bstudies show\b/i,
                /\baccording to\b/i,
                /\bresearch (shows|suggests|indicates)\b/i,
                /\bexperts (say|recommend|suggest)\b/i,
                /\bstatistically\b/i,
                /\b\d+(\.\d+)?%/i,  // percentages
                /https?:\/\//i,     // URLs
            ];
            
            // FALLBACK QUESTIONS (safe responses)
            const fallbackQuestions = [
                "What's coming up for you as you sit with this?",
                "What feels most important about this right now?",
                "What would it mean for you if this worked out?",
                "What's underneath that feeling?",
                "What do you notice in your body as you think about this?",
            ];
            
            // Check all forbidden patterns
            for (const pattern of forbiddenPatterns) {
                if (pattern.test(cleaned)) {
                    // Response contains forbidden content - replace entirely
                    return fallbackQuestions[Math.floor(Math.random() * fallbackQuestions.length)];
                }
            }
            
            // Check question count
            const questionMarks = (cleaned.match(/\?/g) || []).length;
            
            // If no questions, replace
            if (questionMarks === 0) {
                return fallbackQuestions[Math.floor(Math.random() * fallbackQuestions.length)];
            }
            
            // If too many questions (rambling), replace
            if (questionMarks > 3) {
                return fallbackQuestions[Math.floor(Math.random() * fallbackQuestions.length)];
            }
            
            // If too long, truncate or replace
            if (cleaned.length > 300) {
                // Try to find a natural break
                const firstQuestion = cleaned.indexOf('?');
                if (firstQuestion > 0 && firstQuestion < 250) {
                    cleaned = cleaned.substring(0, firstQuestion + 1);
                } else {
                    return fallbackQuestions[Math.floor(Math.random() * fallbackQuestions.length)];
                }
            }
            
            // If statement-heavy (more periods than questions), replace
            const periods = (cleaned.match(/\./g) || []).length;
            if (periods > 2 && periods > questionMarks) {
                return fallbackQuestions[Math.floor(Math.random() * fallbackQuestions.length)];
            }
            
            return cleaned;
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // CLIENT-SIDE SAFETY (Mirrors Proxy Rules for Sovereign Mode)
        // ═══════════════════════════════════════════════════════════════════════════

        // Crisis patterns - show resources, don't call model
        const CRISIS_PATTERNS = [
            /\b(suicide|suicidal|kill myself|end(ing)? my life|want to die)\b/i,
            /\b(self.?harm|cut myself|hurt myself|cutting)\b/i,
            /\b(don'?t want to live|better off dead|no reason to live)\b/i,
            /\b(overdose|take all the pills)\b/i,
            /\b(jump off|hang myself|shoot myself)\b/i,
        ];

        const CRISIS_RESPONSE = `I can hear you're in a really difficult place. I'm not equipped to help with this, but please reach out:

🆘 Crisis Text Line: Text HOME to 741741
🆘 Suicide Prevention: 988 (US)
🆘 Emergency: 911

This tool cannot provide crisis support. Please contact one of these resources now.`;

        // Illegal patterns - hard refuse
        const ILLEGAL_PATTERNS = [
            /\b(how to (make|build) (a |)(bomb|explosive|weapon))\b/i,
            /\b(synthesize|manufacture) (drugs|meth)\b/i,
            /\b(child porn|csam|underage)\b/i,
            /\b(hack into|exploit vulnerability|malware)\b/i,
        ];

        const ILLEGAL_RESPONSE = "I can't engage with that.";

        // Domain patterns - redirect without AI
        const DOMAIN_PATTERNS = {
            medical: /\b(medication|medicine|drug|pill|dosage|prescription|diagnosis|symptom|treatment|doctor|therapist)\b/i,
            legal: /\b(lawsuit|sue|lawyer|attorney|legal|court|police|arrest)\b/i,
            financial: /\b(invest|stock|crypto|bitcoin|trading|gambling|portfolio)\b/i,
        };

        const DOMAIN_RESPONSES = {
            medical: "What's prompting you to think about this? A healthcare provider would be the right person to discuss specifics.",
            legal: "What outcome are you hoping for? A legal professional would be best equipped to guide you.",
            financial: "What's driving this question? A financial advisor could help you think through the details.",
        };

        // Pre-inference gate (runs BEFORE local model)
        function clientSideGate(userMsg) {
            // Crisis check
            for (const pattern of CRISIS_PATTERNS) {
                if (pattern.test(userMsg)) {
                    return { blocked: true, response: CRISIS_RESPONSE, gate: 'crisis' };
                }
            }
            
            // Illegal check
            for (const pattern of ILLEGAL_PATTERNS) {
                if (pattern.test(userMsg)) {
                    return { blocked: true, response: ILLEGAL_RESPONSE, gate: 'illegal' };
                }
            }
            
            // Domain check
            for (const [domain, pattern] of Object.entries(DOMAIN_PATTERNS)) {
                if (pattern.test(userMsg)) {
                    return { blocked: true, response: DOMAIN_RESPONSES[domain], gate: domain };
                }
            }
            
            return { blocked: false };
        }

        // ─── Pre-inference: Reframe user input for reflection ───
        function preProcess(userMsg) {
            // If user is asking for facts, we'll let the system prompt handle it
            // But we can add context hints
            const factPatterns = [
                /^(what is|who is|when did|where is|how many|how much|tell me about)/i,
                /^(explain|describe|define|list)/i
            ];
            
            for (const pattern of factPatterns) {
                if (pattern.test(userMsg.trim())) {
                    // Add a hint for the model
                    return userMsg + "\n[Mirror: respond with a reflective question about why they're asking]";
                }
            }
            
            return userMsg;
        }

        // State
        let mode = null; // 'cloud' | 'sovereign'
        let engine = null;
        let messages = [];
        let isLoading = false;

        // Elements
        const welcomeEl = document.getElementById('welcome');
        const loadingEl = document.getElementById('loading');
        const chatEl = document.getElementById('chat');
        const messagesEl = document.getElementById('messages');
        const inputEl = document.getElementById('input');
        const sendBtn = document.getElementById('send-btn');
        const progressCircle = document.getElementById('progress-circle');
        const progressPercent = document.getElementById('progress-percent');
        const loadingStatus = document.getElementById('loading-status');
        const modeLabel = document.getElementById('mode-label');
        const sessionCounter = document.getElementById('session-counter');

        // Check device capabilities
        const isMobile = /iPhone|iPad|Android/i.test(navigator.userAgent);
        const hasWebGPU = !!navigator.gpu;

        // Hide sovereign option on mobile
        if (isMobile || !hasWebGPU) {
            document.getElementById('sovereign-card').style.display = 'none';
        }

        // ─── Proxy Health Check ───
        let proxyOnline = false;
        const proxyBadge = document.getElementById('proxy-badge');
        const proxyDot = document.getElementById('proxy-dot');
        
        async function checkProxyHealth() {
            try {
                const res = await fetch(`${SAFETY_PROXY_URL}/health`, { 
                    method: 'GET',
                    signal: AbortSignal.timeout(5000)
                });
                if (res.ok) {
                    proxyOnline = true;
                    if (proxyBadge) {
                        proxyBadge.textContent = '🛡️ Protected';
                        proxyBadge.style.background = '#22c55e22';
                        proxyBadge.style.color = '#22c55e';
                    }
                    if (proxyDot) proxyDot.style.background = '#22c55e';
                    return true;
                }
            } catch (e) {
                console.warn('Proxy offline:', e);
            }
            proxyOnline = false;
            if (proxyBadge) {
                proxyBadge.textContent = '⚠️ Direct';
                proxyBadge.style.background = '#f59e0b22';
                proxyBadge.style.color = '#f59e0b';
            }
            if (proxyDot) proxyDot.style.background = '#f59e0b';
            return false;
        }
        
        // Check proxy on load
        checkProxyHealth();
        // Re-check every 30 seconds
        setInterval(checkProxyHealth, 30000);

        // ─── Cloud Mode ───
        window.startCloud = function () {
            mode = 'cloud';
            modeLabel.textContent = 'Cloud';
            showChat();
            addMessage('ai', "What's alive for you right now?");
        };

        // ─── Sovereign Mode ───
        window.startSovereign = async function () {
            mode = 'sovereign';
            modeLabel.textContent = 'Sovereign';
            welcomeEl.classList.add('hidden');
            loadingEl.classList.add('active');
            loadingStatus.textContent = 'Step 1: Checking WebGPU...';

            try {
                // Check WebGPU first
                if (!navigator.gpu) {
                    throw new Error('WebGPU not supported. Try Chrome 113+ or Edge.');
                }
                loadingStatus.textContent = 'Step 2: Getting GPU adapter...';
                
                const adapter = await navigator.gpu.requestAdapter();
                if (!adapter) {
                    throw new Error('No WebGPU adapter. GPU may not be supported.');
                }
                loadingStatus.textContent = 'Step 3: Loading WebLLM...';
                
                let CreateWebWorkerMLCEngine;
                try {
                    const module = await import('https://cdn.jsdelivr.net/npm/@mlc-ai/web-llm@0.2.73/+esm');
                    CreateWebWorkerMLCEngine = module.CreateWebWorkerMLCEngine;
                } catch (e) {
                    throw new Error('Failed to load WebLLM: ' + e.message);
                }
                
                loadingStatus.textContent = 'Step 4: Creating worker...';

                // Create worker
                const workerCode = `
                    import { WebWorkerMLCEngineHandler } from 'https://cdn.jsdelivr.net/npm/@mlc-ai/web-llm@0.2.73/+esm';
                    const handler = new WebWorkerMLCEngineHandler();
                    self.onmessage = (e) => handler.onmessage(e);
                `;
                const blob = new Blob([workerCode], { type: 'text/javascript' });
                const workerUrl = URL.createObjectURL(blob);
                let worker;
                try {
                    worker = new Worker(workerUrl, { type: 'module' });
                } catch (e) {
                    throw new Error('Worker creation failed: ' + e.message);
                }

                loadingStatus.textContent = 'Step 5: Downloading model (~900MB)...';

                try {
                    engine = await CreateWebWorkerMLCEngine(
                        worker,
                        MODEL_ID,
                        {
                            initProgressCallback: (progress) => {
                                const pct = Math.round(progress.progress * 100);
                                progressPercent.textContent = pct + '%';
                                progressCircle.style.strokeDashoffset = 440 - (440 * progress.progress);
                                loadingStatus.textContent = progress.text || `Downloading... ${pct}%`;

                                if (pct < 50) {
                                    progressCircle.style.stroke = '#3b82f6';
                                } else if (pct < 90) {
                                    progressCircle.style.stroke = '#8b5cf6';
                                } else {
                                    progressCircle.style.stroke = '#10b981';
                                }
                            }
                        }
                    );
                } catch (e) {
                    throw new Error('Model load failed: ' + e.message);
                }

                URL.revokeObjectURL(workerUrl);
                loadingEl.classList.remove('active');
                showChat();
                addMessage('ai', "Your sovereign AI is ready. What's on your mind?");

            } catch (err) {
                console.error('Sovereign mode failed:', err);
                const errorMsg = err.message || 'Unknown error';
                loadingStatus.style.color = '#ef4444';
                loadingStatus.innerHTML = `❌ ${errorMsg}<br><br><small>Switching to cloud in 5 seconds...</small><br><br><button onclick="window.startCloud()" style="padding: 12px 24px; background: #3b82f6; border: none; border-radius: 8px; color: white; cursor: pointer;">Use Cloud Mode Now</button>`;
                
                // Auto-switch to cloud after 5 seconds
                setTimeout(() => {
                    loadingEl.classList.remove('active');
                    window.startCloud();
                }, 5000);
            }
        };

        // ─── Show Chat ───
        function showChat() {
            welcomeEl.classList.add('hidden');
            chatEl.classList.add('active');
            inputEl.focus();
        }

        // ─── Show Welcome ───
        window.showWelcome = function () {
            chatEl.classList.remove('active');
            welcomeEl.classList.remove('hidden');
            messages = [];
            messagesEl.innerHTML = '';
            updateCounter();
        };

        // ─── Add Message ───
        function addMessage(role, content) {
            messages.push({ role, content });

            const div = document.createElement('div');
            div.className = `message message-${role}`;
            div.textContent = content;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;

            updateCounter();
        }

        // ─── Update Counter ───
        function updateCounter() {
            const count = messages.filter(m => m.role === 'user').length;
            if (count === 0) {
                sessionCounter.textContent = 'Start your reflection';
            } else {
                sessionCounter.textContent = `${count} reflection${count === 1 ? '' : 's'} this session`;
            }
        }

        // ─── Show Thinking ───
        function showThinking() {
            const div = document.createElement('div');
            div.className = 'thinking';
            div.id = 'thinking';
            div.innerHTML = '<span class="thinking-glyph">⟡</span> Reflecting...';
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function hideThinking() {
            const el = document.getElementById('thinking');
            if (el) el.remove();
        }

        // ─── Client-Side Rate Limiting ───
        const rateLimitState = {
            lastSend: 0,
            count: 0,
            windowStart: Date.now()
        };
        
        function checkClientRateLimit() {
            const now = Date.now();
            const minInterval = 2000;  // 2 seconds between messages
            const maxPerMinute = 20;   // Max 20 messages per minute
            
            // Check minimum interval
            if (now - rateLimitState.lastSend < minInterval) {
                return { allowed: false, message: "Please slow down. Take a breath between thoughts." };
            }
            
            // Reset window if over a minute
            if (now - rateLimitState.windowStart > 60000) {
                rateLimitState.count = 0;
                rateLimitState.windowStart = now;
            }
            
            // Check messages per minute
            if (rateLimitState.count >= maxPerMinute) {
                return { allowed: false, message: "You're moving quickly. What's the urgency underneath?" };
            }
            
            return { allowed: true };
        }

        // ─── Send Message ───
        window.send = async function () {
            const text = inputEl.value.trim();
            if (!text || isLoading) return;
            
            // Client-side rate limit
            const rateCheck = checkClientRateLimit();
            if (!rateCheck.allowed) {
                addMessage('ai', rateCheck.message);
                return;
            }
            
            // Update rate limit state
            rateLimitState.lastSend = Date.now();
            rateLimitState.count++;

            inputEl.value = '';
            addMessage('user', text);
            
            // SAFETY CHECK FIRST - before any AI involvement
            const safety = safetyCheck(text);
            
            if (!safety.safe) {
                // Don't send to AI - use hardcoded response
                addMessage('ai', safety.response);
                return;
            }
            
            isLoading = true;
            sendBtn.disabled = true;
            showThinking();

            try {
                let response;
                
                // Add safety hint to redirected topics
                const msgToSend = safety.hint ? text + '\n' + safety.hint : text;

                if (mode === 'cloud') {
                    response = await cloudInference(msgToSend);
                } else {
                    response = await localInference(msgToSend);
                }

                hideThinking();
                addMessage('ai', response);

            } catch (err) {
                console.error('Inference failed:', err);
                hideThinking();
                addMessage('ai', "What feels most important about what you just shared?");
            }

            isLoading = false;
            sendBtn.disabled = false;
            inputEl.focus();
        };

        // ─── Safety Proxy Configuration ───
        const SAFETY_PROXY_URL = 'https://proxy.activemirror.ai';
        const PROXY_ENABLED = true;  // Set to false to bypass proxy (dev only)
        
        // ─── Cloud Inference (via Safety Proxy) ───
        async function cloudInference(userMsg) {
            if (PROXY_ENABLED) {
                // Route through Mac Mini safety proxy
                const res = await fetch(`${SAFETY_PROXY_URL}/api/reflect`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        input: userMsg,
                        mode: 'cloud',
                        timestamp: Math.floor(Date.now() / 1000)
                    })
                });
                
                if (!res.ok) throw new Error('Proxy unavailable');
                const data = await res.json();
                
                // Update mode badge if proxy reports error
                if (data.safety_outcome === 'error') {
                    console.warn('Proxy model error, using fallback');
                }
                
                return data.output;
            }
            
            // Fallback: Direct Groq call (dev only, not recommended)
            const processedMsg = preProcess(userMsg);
            const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${GROQ_KEY}`
                },
                body: JSON.stringify({
                    model: 'llama-3.3-70b-versatile',
                    messages: [
                        { role: 'system', content: SYSTEM_PROMPT },
                        ...messages.slice(-8).map(m => ({
                            role: m.role === 'ai' ? 'assistant' : m.role,
                            content: m.content
                        })),
                        { role: 'user', content: processedMsg }
                    ],
                    temperature: 0.3,
                    max_tokens: 100
                })
            });

            if (!res.ok) throw new Error('API failed');
            const data = await res.json();
            const raw = data.choices[0]?.message?.content || "What's underneath that?";
            return wrapReflection(raw);
        }

        // ─── Local Inference (with client-side safety) ───
        async function localInference(userMsg) {
            // CLIENT-SIDE GATE: Check BEFORE calling local model
            const gateResult = clientSideGate(userMsg);
            if (gateResult.blocked) {
                DEBUG && console.log(`[MirrorGate] Blocked by: ${gateResult.gate}`);
                return gateResult.response;
            }
            
            const processedMsg = preProcess(userMsg);
            
            const result = await engine.chat.completions.create({
                messages: [
                    { role: 'system', content: SYSTEM_PROMPT },
                    ...messages.slice(-8).map(m => ({
                        role: m.role === 'ai' ? 'assistant' : m.role,
                        content: m.content
                    })),
                    { role: 'user', content: processedMsg }
                ],
                temperature: 0.3,
                max_tokens: 80  // Reduced from 100 to prevent drift
            });

            const raw = result.choices[0]?.message?.content || "What feels true about that?";
            
            // POST-FILTER: Validate and clean output
            const filtered = wrapReflection(raw);
            
            DEBUG && console.log(`[MirrorGate] Local output validated`);
            return filtered;
        }

        // ─── Enter to Send ───
        inputEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                window.send();
            }
        });

        // ─── Keyboard Shortcuts ───
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                window.showWelcome();
            }
            if (e.key === '/' && document.activeElement !== inputEl) {
                e.preventDefault();
                inputEl.focus();
            }
        });
    </script>
</body>

</html>