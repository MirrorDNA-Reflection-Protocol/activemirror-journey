{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/shadow_runtime_receipt.v0_1.json",
  "title": "AMOS Shadow Runtime Receipt",
  "type": "object",
  "required": ["shadow_runtime_receipt"],
  "additionalProperties": false,
  "properties": {
    "shadow_runtime_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "blocked_live_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "shadow_runtime_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allow", "block"] },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "blocked_live_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "receipt_only" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
