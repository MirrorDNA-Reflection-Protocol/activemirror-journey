{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/browser_runtime_adapter_receipt.v0_1.json",
  "title": "AMOS Browser Runtime Adapter Receipt",
  "type": "object",
  "required": ["browser_runtime_adapter_receipt"],
  "additionalProperties": false,
  "properties": {
    "browser_runtime_adapter_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "runtime_projection",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "browser_runtime_adapter_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allow", "block"] },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "runtime_projection": {
          "type": "object",
          "required": ["turn_id", "input_hash", "boundary", "requested_output", "allowed_actions", "result"],
          "additionalProperties": false,
          "properties": {
            "turn_id": { "type": "string", "minLength": 1 },
            "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "boundary": { "type": "string", "minLength": 1 },
            "requested_output": { "type": "string", "minLength": 1 },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "result": { "type": "string", "minLength": 1 }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "runtime_projection_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
