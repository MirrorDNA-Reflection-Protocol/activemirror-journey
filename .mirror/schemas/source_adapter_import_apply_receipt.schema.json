{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/source_adapter_import_apply_receipt.v0_1.json",
  "title": "AMOS Source Adapter Import Apply Readiness Receipt",
  "type": "object",
  "required": ["source_adapter_import_apply_receipt"],
  "additionalProperties": false,
  "properties": {
    "source_adapter_import_apply_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "approval_scope",
        "patch_file",
        "patch_file_hash",
        "patch_receipt",
        "rollback_written",
        "rollback_file",
        "rollback_file_hash",
        "target_file",
        "target_hash_before",
        "target_hash_after",
        "target_modified",
        "source_file",
        "source_hash",
        "patch_applied",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "approval_request_result",
        "patch_receipt_result",
        "git_apply_check",
        "rollback_summary",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "source_adapter_import_apply_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["apply_ready", "block"] },
        "approval_scope": { "const": "apply_readiness_only" },
        "patch_file": { "type": "string", "minLength": 1 },
        "patch_file_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "patch_receipt": { "type": "string", "minLength": 1 },
        "rollback_written": { "type": "boolean" },
        "rollback_file": { "type": "string" },
        "rollback_file_hash": { "type": "string", "pattern": "^(|[a-f0-9]{64})$" },
        "target_file": { "const": "src/pages/HomePage.jsx" },
        "target_hash_before": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_hash_after": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_modified": { "const": false },
        "source_file": { "const": "src/lib/amos-disabled-source-adapter.js" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "patch_applied": { "const": false },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "approval_request_result": {
          "type": "object",
          "required": ["ok", "status", "approval_required", "file"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "status": { "const": "pending" },
            "approval_required": { "const": true },
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "patch_receipt_result": {
          "type": "object",
          "required": ["ok", "decision", "patch_written", "target_modified", "performed_live_action", "file"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "decision": { "const": "patch_prepared" },
            "patch_written": { "const": true },
            "target_modified": { "const": false },
            "performed_live_action": { "const": false },
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "git_apply_check": {
          "type": "object",
          "required": ["ok", "command", "exit_code"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "command": { "const": "git apply --check" },
            "exit_code": { "type": "integer" }
          }
        },
        "rollback_summary": {
          "type": "object",
          "required": ["kind", "removes_import", "requires_future_apply_state"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "inverse_import_line_patch" },
            "removes_import": { "const": true },
            "requires_future_apply_state": { "const": true }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "source_adapter_import_apply_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
