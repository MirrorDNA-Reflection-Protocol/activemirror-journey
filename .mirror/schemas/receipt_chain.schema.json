{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/receipt_chain.schema.json",
  "title": "Active Mirror Receipt Chain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chain_id",
    "created_at",
    "receipt_root",
    "algorithm",
    "entry_count",
    "chain_hash",
    "entries",
    "unchecked_scope"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "receipt_chain.v0_1" },
    "chain_id": { "type": "string" },
    "created_at": { "type": "string" },
    "receipt_root": { "type": "string" },
    "algorithm": { "type": "string" },
    "entry_count": { "type": "integer", "minimum": 1 },
    "chain_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "file",
          "audit_id",
          "created_at",
          "decision",
          "content_hash",
          "entry_hash",
          "previous_chain_hash",
          "chain_hash"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "file": { "type": "string" },
          "audit_id": { "type": "string" },
          "created_at": { "type": "string" },
          "decision": { "type": "string", "enum": ["pass", "partial", "fail"] },
          "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "entry_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "previous_chain_hash": { "type": "string" },
          "chain_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "unchecked_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
