{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/source_adapter_invocation_contract_request.v0_1.json",
  "title": "AMOS Source Adapter Invocation Contract Request",
  "type": "object",
  "required": ["source_adapter_invocation_contract_request"],
  "additionalProperties": false,
  "properties": {
    "source_adapter_invocation_contract_request": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "surface",
        "mode",
        "adapter",
        "route",
        "source_file",
        "target_file",
        "allowed_invoker",
        "allowed_input_receipt",
        "allowed_output",
        "invocation_enabled",
        "model_call_enabled",
        "network_enabled",
        "durable_memory_write_enabled",
        "route_change_enabled",
        "gateway_change_enabled",
        "public_deploy_enabled",
        "arbitrary_ui_enabled",
        "required_gates",
        "output_type",
        "claim_boundary",
        "blocked_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "source_adapter_invocation_contract_request.v0_1" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
        "surface": { "const": "consumer_app" },
        "mode": { "const": "invocation_contract_declared_only" },
        "adapter": { "const": "amos_disabled_source_adapter" },
        "route": { "const": "/app/" },
        "source_file": { "const": "src/lib/amos-disabled-source-adapter.js" },
        "target_file": { "const": "src/pages/HomePage.jsx" },
        "allowed_invoker": { "const": "src/pages/HomePage.jsx" },
        "allowed_input_receipt": { "const": "ui_harness_receipt" },
        "allowed_output": { "const": "disabled_source_adapter_projection" },
        "invocation_enabled": { "const": false },
        "model_call_enabled": { "const": false },
        "network_enabled": { "const": false },
        "durable_memory_write_enabled": { "const": false },
        "route_change_enabled": { "const": false },
        "gateway_change_enabled": { "const": false },
        "public_deploy_enabled": { "const": false },
        "arbitrary_ui_enabled": { "const": false },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output_type": { "const": "source_adapter_invocation_contract_receipt" },
        "claim_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
