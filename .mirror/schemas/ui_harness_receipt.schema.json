{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/ui_harness_receipt.v0_1.json",
  "title": "AMOS Local UI Harness Receipt",
  "type": "object",
  "required": ["ui_harness_receipt"],
  "additionalProperties": false,
  "properties": {
    "ui_harness_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "runtime_adapter_result",
        "ui_projection",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "ui_harness_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allow", "block"] },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "runtime_adapter_result": {
          "type": "object",
          "required": ["ok", "decision", "request_id", "input_hash", "result"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "decision": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "result": { "type": "string", "minLength": 1 }
          }
        },
        "ui_projection": {
          "type": "object",
          "required": [
            "route",
            "surface",
            "entry_question",
            "primary_action",
            "response_surface",
            "secondary_surface",
            "copy_mode",
            "safe_status_label",
            "runtime_result"
          ],
          "additionalProperties": false,
          "properties": {
            "route": { "type": "string", "minLength": 1 },
            "surface": { "type": "string", "minLength": 1 },
            "entry_question": { "type": "string", "minLength": 1 },
            "primary_action": { "type": "string", "minLength": 1 },
            "response_surface": { "type": "string", "minLength": 1 },
            "secondary_surface": { "type": "string", "minLength": 1 },
            "copy_mode": { "type": "string", "minLength": 1 },
            "safe_status_label": { "type": "string", "minLength": 1 },
            "runtime_result": { "type": "string", "minLength": 1 }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "ui_harness_projection_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
