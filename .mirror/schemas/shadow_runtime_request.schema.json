{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/shadow_runtime_request.v0_1.json",
  "title": "AMOS Shadow Runtime Request",
  "type": "object",
  "required": ["shadow_runtime_request"],
  "additionalProperties": false,
  "properties": {
    "shadow_runtime_request": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "surface",
        "mode",
        "proposed_adapter",
        "intent",
        "requested_action",
        "live_action_enabled",
        "network_enabled",
        "model_call_enabled",
        "external_write_enabled",
        "public_route_enabled",
        "reads",
        "writes",
        "egress",
        "required_gates",
        "receipt",
        "output_type",
        "claim_boundary",
        "blocked_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "shadow_runtime_request.v0_1" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
        "surface": { "enum": ["consumer_app", "gateway_worker", "local_console"] },
        "mode": { "const": "shadow_dry_run" },
        "proposed_adapter": { "const": "shadow_dry_run_adapter" },
        "intent": { "type": "string", "minLength": 1 },
        "requested_action": { "type": "string", "minLength": 1 },
        "live_action_enabled": { "const": false },
        "network_enabled": { "const": false },
        "model_call_enabled": { "const": false },
        "external_write_enabled": { "const": false },
        "public_route_enabled": { "const": false },
        "reads": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "egress": { "const": "none" },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "receipt": {
          "type": "object",
          "required": ["enabled", "destination", "content"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "const": true },
            "destination": { "const": ".mirror/RUNTIME_DRY_RUNS" },
            "content": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "output_type": { "const": "receipt_only" },
        "claim_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
