{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/browser_runtime_adapter_request.v0_1.json",
  "title": "AMOS Browser Runtime Adapter Request",
  "type": "object",
  "required": ["browser_runtime_adapter_request"],
  "additionalProperties": false,
  "properties": {
    "browser_runtime_adapter_request": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "surface",
        "mode",
        "adapter",
        "route",
        "runtime_request",
        "write_destination",
        "model_call_enabled",
        "network_enabled",
        "durable_memory_write_enabled",
        "route_change_enabled",
        "gateway_change_enabled",
        "public_deploy_enabled",
        "required_gates",
        "output_type",
        "claim_boundary",
        "blocked_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "browser_runtime_adapter_request.v0_1" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
        "surface": { "const": "consumer_app" },
        "mode": { "const": "browser_local_proposal" },
        "adapter": { "const": "browser_local_runtime_adapter" },
        "route": { "const": "/app/" },
        "runtime_request": {
          "type": "object",
          "required": ["turn_id", "input", "boundary", "requested_output", "allowed_actions"],
          "additionalProperties": false,
          "properties": {
            "turn_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
            "input": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "boundary": { "enum": ["private_first", "use_placeholders", "source_sensitive"] },
            "requested_output": { "enum": ["next_move", "draft", "plan", "question"] },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["local_response_projection", "local_receipt"] }
            }
          }
        },
        "write_destination": { "const": ".mirror/RUNTIME_DRY_RUNS" },
        "model_call_enabled": { "const": false },
        "network_enabled": { "const": false },
        "durable_memory_write_enabled": { "const": false },
        "route_change_enabled": { "const": false },
        "gateway_change_enabled": { "const": false },
        "public_deploy_enabled": { "const": false },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output_type": { "const": "runtime_projection_receipt" },
        "claim_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
