{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/source_adapter_import_receipt.v0_1.json",
  "title": "AMOS Source Adapter Import Receipt",
  "type": "object",
  "required": ["source_adapter_import_receipt"],
  "additionalProperties": false,
  "properties": {
    "source_adapter_import_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "approval_required",
        "approval_status",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "source_file",
        "source_hash",
        "target_files",
        "import_scan",
        "disabled_adapter_result",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "source_adapter_import_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approval_required", "block"] },
        "approval_required": { "const": true },
        "approval_status": { "const": "pending" },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "source_file": { "type": "string", "minLength": 1 },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "hash", "imports_adapter"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "imports_adapter": { "const": false }
            }
          }
        },
        "import_scan": {
          "type": "object",
          "required": ["import_allowed", "active_import_count", "active_imports"],
          "additionalProperties": false,
          "properties": {
            "import_allowed": { "const": false },
            "active_import_count": { "type": "integer", "minimum": 0 },
            "active_imports": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "disabled_adapter_result": {
          "type": "object",
          "required": ["ok", "decision", "request_id"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "decision": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string" }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "source_adapter_import_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
