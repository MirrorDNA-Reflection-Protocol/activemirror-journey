{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/source_adapter_import_applied_receipt.v0_1.json",
  "title": "AMOS Source Adapter Import Applied Receipt",
  "type": "object",
  "required": ["source_adapter_import_applied_receipt"],
  "additionalProperties": false,
  "properties": {
    "source_adapter_import_applied_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "approval_scope",
        "approval_evidence",
        "approval_request_result",
        "source_file",
        "source_hash",
        "target_file",
        "target_hash",
        "import_scan",
        "adapter_invoked",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "source_adapter_import_applied_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["imported_disabled", "block"] },
        "approval_scope": { "const": "chat_approved_source_import_only" },
        "approval_evidence": { "type": "string", "minLength": 1 },
        "approval_request_result": {
          "type": "object",
          "required": ["ok", "status", "file"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "status": { "const": "pending" },
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "source_file": { "const": "src/lib/amos-disabled-source-adapter.js" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_file": { "const": "src/pages/HomePage.jsx" },
        "target_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "import_scan": {
          "type": "object",
          "required": ["import_line_count", "import_lines", "adapter_invocation_count"],
          "additionalProperties": false,
          "properties": {
            "import_line_count": { "const": 1 },
            "import_lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "required": ["line", "line_number"],
                "additionalProperties": false,
                "properties": {
                  "line": { "type": "string", "minLength": 1 },
                  "line_number": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "adapter_invocation_count": { "const": 0 }
          }
        },
        "adapter_invoked": { "const": false },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "source_adapter_import_applied_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
