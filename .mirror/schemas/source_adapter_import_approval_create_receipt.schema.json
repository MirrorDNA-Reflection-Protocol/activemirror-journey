{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/source_adapter_import_approval_create_receipt.v0_1.json",
  "title": "AMOS Source Adapter Import Approval Create Receipt",
  "type": "object",
  "required": ["source_adapter_import_approval_create_receipt"],
  "additionalProperties": false,
  "properties": {
    "source_adapter_import_approval_create_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "request_id",
        "created_at",
        "decision",
        "approval_required",
        "approval_status",
        "approval_written",
        "approval_file",
        "approval_file_hash",
        "performed_live_action",
        "checked_scope",
        "gate_results",
        "approval_bridge_result",
        "approval_request_result",
        "blocked_capabilities",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "source_adapter_import_approval_create_receipt.v0_1" },
        "id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approval_required", "block"] },
        "approval_required": { "const": true },
        "approval_status": { "const": "pending" },
        "approval_written": { "type": "boolean" },
        "approval_file": { "type": "string" },
        "approval_file_hash": { "type": "string", "pattern": "^(|[a-f0-9]{64})$" },
        "performed_live_action": { "const": false },
        "checked_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok", "decision"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "approval_bridge_result": {
          "type": "object",
          "required": ["ok", "decision", "approval_written"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "decision": { "const": "approval_required" },
            "approval_written": { "const": false }
          }
        },
        "approval_request_result": {
          "type": "object",
          "required": ["ok", "decision", "wrote", "file", "approval_required", "status"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "decision": { "const": "approval_required" },
            "wrote": { "type": "boolean" },
            "file": { "type": "string" },
            "approval_required": { "const": true },
            "status": { "const": "pending" }
          }
        },
        "blocked_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "source_adapter_import_approval_create_receipt" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
