{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/readonly_app_adapter_request.v0_1.json",
  "title": "AMOS Read-Only App Adapter Request",
  "type": "object",
  "required": ["readonly_app_adapter_request"],
  "additionalProperties": false,
  "properties": {
    "readonly_app_adapter_request": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "surface",
        "mode",
        "adapter",
        "route",
        "intent",
        "source_files",
        "request_envelope",
        "write_destination",
        "model_call_enabled",
        "network_enabled",
        "memory_write_enabled",
        "route_change_enabled",
        "gateway_change_enabled",
        "public_deploy_enabled",
        "required_gates",
        "output_type",
        "claim_boundary",
        "blocked_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "readonly_app_adapter_request.v0_1" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
        "surface": { "const": "consumer_app" },
        "mode": { "const": "read_only_proposal" },
        "adapter": { "const": "readonly_app_adapter" },
        "route": { "const": "/app/" },
        "intent": { "type": "string", "minLength": 1 },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "request_envelope": { "type": "string", "minLength": 1 },
        "write_destination": { "const": ".mirror/RUNTIME_DRY_RUNS" },
        "model_call_enabled": { "const": false },
        "network_enabled": { "const": false },
        "memory_write_enabled": { "const": false },
        "route_change_enabled": { "const": false },
        "gateway_change_enabled": { "const": false },
        "public_deploy_enabled": { "const": false },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "output_type": { "const": "source_hash_receipt" },
        "claim_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
