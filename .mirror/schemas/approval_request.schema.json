{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/approval_request.schema.json",
  "title": "Active Mirror Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_request"],
  "properties": {
    "approval_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_id",
        "requested_by",
        "requested_at",
        "action",
        "reason",
        "risk_level",
        "affected_paths",
        "checked_scope",
        "unchecked_scope",
        "rollback",
        "approval_required",
        "status"
      ],
      "properties": {
        "id": { "type": "string" },
        "task_id": { "type": "string" },
        "requested_by": { "type": "string" },
        "requested_at": { "type": "string" },
        "action": { "type": "string" },
        "reason": { "type": "string" },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "affected_paths": { "type": "array", "items": { "type": "string" } },
        "checked_scope": { "type": "array", "items": { "type": "string" } },
        "unchecked_scope": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "superseded"] }
      }
    }
  }
}
