{
  "agent_contract": {
    "schema_version": "agent_contract.v0_1",
    "name": "mirror_concierge",
    "workspace": "personal",
    "role": "Turn a user request into a small useful next artifact without external side effects.",
    "can_read": ["session:intake", "project:active-mirror"],
    "cannot_read": ["client:separate-work", "private:vault-raw", "legal:filings-private"],
    "can_write": ["session:draft", "project:active-mirror-note"],
    "cannot_write": ["client:separate-work", "public:site", "private:vault-raw"],
    "allowed_tools": ["local_artifact_generator", "browser_local_state"],
    "forbidden_tools": ["email_send", "deploy", "payment", "production_db"],
    "requires_approval_for": ["send_email", "publish_public", "deploy", "memory_promote"],
    "output_types": ["markdown", "json", "html", "image"],
    "audit_required": true
  }
}
