{
    "name": "activemirror-journey",
    "private": true,
    "version": "2.0.0",
    "description": "Active Mirror reflection front door",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "prebuild": "npm run guard:canonical && npm run guard:mirror && npm run guard:continuity && npm run guard:amos-contracts && npm run guard:memory-proposal && npm run guard:approval-request && npm run guard:artifact-export && npm run guard:audit-log && npm run guard:receipt-chain && npm run guard:runtime-integration && npm run guard:shadow-adapter && npm run guard:readonly-app-adapter && npm run guard:browser-runtime-adapter && npm run guard:front-door && npm run guard:language && npm run guard:multilingual && npm run guard:friction && npm run guard:challenge && npm run guard:redaction && npm run truth",
        "build": "vite build --base=/app/ && cp dist/index.html dist/404.html",
        "prebuild:deploy": "npm run prebuild",
        "build:deploy": "VITE_ACTIVE_MIRROR_REMOTE_EVENTS=true vite build --base=/app/ && cp dist/index.html dist/404.html",
        "preview": "vite preview",
        "guard:canonical": "node scripts/canonical_source_guard.mjs",
        "guard:mirror": "node scripts/mirror_control_guard.mjs",
        "guard:mirror-control": "npm run guard:mirror",
        "guard:continuity": "node scripts/continuity_guard.mjs",
        "guard:front-door": "node scripts/front_door_guard.mjs",
        "guard:language": "node scripts/public_language_guard.mjs",
        "guard:multilingual": "node scripts/multilingual_guard.mjs",
        "guard:friction": "node scripts/first_turn_friction_guard.mjs",
        "guard:challenge": "node scripts/challenge_packet_guard.mjs",
        "guard:dossiers": "node scripts/dossier_guard.mjs",
        "guard:amos-contracts": "node scripts/amos_contract_gate.mjs --self-test",
        "guard:memory-proposal": "node scripts/amos_memory_proposal_gate.mjs --self-test",
        "guard:approval-request": "node scripts/amos_approval_request_gate.mjs --self-test",
        "guard:artifact-export": "node scripts/amos_artifact_export_gate.mjs --self-test",
        "guard:audit-log": "node scripts/amos_audit_log_gate.mjs --self-test",
        "guard:receipt-chain": "node scripts/amos_receipt_chain_gate.mjs --verify",
        "guard:runtime-integration": "node scripts/amos_runtime_integration_gate.mjs --self-test",
        "guard:shadow-adapter": "node scripts/amos_shadow_adapter_gate.mjs --self-test",
        "guard:readonly-app-adapter": "node scripts/amos_readonly_app_adapter_gate.mjs --self-test",
        "guard:browser-runtime-adapter": "node scripts/amos_browser_runtime_adapter_gate.mjs --self-test",
        "guard:redaction": "bash scripts/redaction_guard.sh",
        "truth": "python3 scripts/active_mirror_truth_gate.py --out outputs/active-mirror-truth-gate.json",
        "amos:status": "node scripts/amos_status_report.mjs",
        "mirror:report": "node scripts/mirror_control_report.mjs",
        "mirror:context": "node scripts/mirror_context_pack_builder.mjs",
        "mirror:context:bundle": "node scripts/mirror_context_pack_builder.mjs --bundle --out outputs/active-mirror-context-bundle.md",
        "wiki:obsidian": "node scripts/sync_wiki_to_obsidian.mjs",
        "wiki:obsidian:dry": "node scripts/sync_wiki_to_obsidian.mjs --dry-run",
        "eval:mirror": "node scripts/mirror-eval.mjs",
        "ops:snapshot": "bash scripts/control_plane_snapshot.sh",
        "ops:diff": "bash scripts/control_plane_diff.sh",
        "smoke:prod": "bash scripts/smoke_prod.sh",
        "proxy": "cd safety_proxy && python3 safety_proxy.py",
        "deploy": "echo \"Direct deploy is disabled. Build here, then copy the /app bundle through /Users/mirror-pro/repos/active-mirror-site.\" && exit 1"
    },
    "dependencies": {
        "@mlc-ai/web-llm": "^0.2.84",
        "@studio-freight/lenis": "^1.0.42",
        "clsx": "^2.1.1",
        "framer-motion": "^11.18.2",
        "html2canvas": "^1.4.1",
        "jszip": "^3.10.1",
        "lucide-react": "^0.469.0",
        "mammoth": "^1.12.0",
        "pdfjs-dist": "^6.0.227",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.11.0",
        "read-excel-file": "^9.2.0",
        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "gh-pages": "^6.3.0",
        "playwright": "^1.61.1",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "vite": "^6.4.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MirrorDNA-Reflection-Protocol/activemirror-journey"
    },
    "author": "N1 Intelligence (OPC) Pvt Ltd",
    "license": "MIT"
}
